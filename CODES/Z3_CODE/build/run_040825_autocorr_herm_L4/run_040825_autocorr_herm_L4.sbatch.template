#!/bin/bash
# Job name:
#SBATCH --job-name=run_040825_autocorr_herm_L4
#
# Partition:
#SBATCH --partition=*partition*
#
# Processors:
#SBATCH --ntasks=*nnn*
#SBATCH --nodes=*NNN*
#
# Wall clock limit:
#SBATCH --time=*ttt*
#
# Email at end:
#SBATCH --mail-user=*myemail*
#SBATCH --mail-type=END
#
# Specify output files:
#SBATCH -o run_040825_autocorr_herm_L4.o%j
#------------------------------------------------------

echo "Starting job run_040825_autocorr_herm_L4"

module load launcher

export LAUNCHER_PLUGIN_DIR=$LAUNCHER_DIR/plugins
export LAUNCHER_RMI=SLURM
export LAUNCHER_JOB_FILE=run_040825_autocorr_herm_L4.task
export LAUNCHER_SCHED=interleaved

$LAUNCHER_DIR/paramrun

echo "Job run_040825_autocorr_herm_L4 complete"
