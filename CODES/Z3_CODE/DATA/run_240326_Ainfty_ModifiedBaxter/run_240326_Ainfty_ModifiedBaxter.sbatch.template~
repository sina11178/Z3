#!/bin/bash
# Job name:
#SBATCH --job-name=run_220625_Imbalance
#
# Partition:
#SBATCH --partition=*partition*
#
# Account:
#SBATCH -A *charge* # which account to charge the SUs to
#
# Processors:
#SBATCH --ntasks=*nnn*
#SBATCH --nodes=*NNN*
#SBATCH --cpus-per-task=*ccc*
#
# Wall clock limit:
#SBATCH --time=*ttt*
#
# Email at end:
#SBATCH --mail-user=*myemail*
#SBATCH --mail-type=END
#
# Specify output files:
#SBATCH -o run_220625_Imbalance.o%j
#------------------------------------------------------

echo "Starting job run_220625_Imbalance"
echo "*JobDetails*"
module load launcher

export LAUNCHER_PLUGIN_DIR=$LAUNCHER_DIR/plugins
export LAUNCHER_RMI=SLURM
export LAUNCHER_JOB_FILE=run_220625_Imbalance.task
export LAUNCHER_SCHED=interleaved

$LAUNCHER_DIR/paramrun

echo "Job run_220625_Imbalance complete"
