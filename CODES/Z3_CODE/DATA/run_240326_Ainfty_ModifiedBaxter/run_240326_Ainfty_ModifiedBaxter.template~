#!/usr/bin/bash
# Template for ".qsub" files that will be run as batch files by slurm

RUN_NAME=run_240326_Ainfty_ModifiedBaxter
PROJECT_NAME=*project*
SCRATCH_DIR=$SCRATCH/$RUN_NAME/b###
LOCAL_DIR=$HOME/Project/$PROJECT_NAME/build

mkdir -p $SCRATCH_DIR


EXEC1=Sim_AutoCorrelation.py
HELPER1="model_NearlyZero_Z3_EM.py"


cd $LOCAL_DIR/$RUN_NAME
cp $EXEC1 $SCRATCH_DIR/
if [ ! -z "$HELPER1" ] # Check that HELPER isn't empty
then
    cp $HELPER1 $SCRATCH_DIR/
fi    



cd $SCRATCH_DIR/



{ time  python $EXEC1  *LLL*   *JJJ*   *fff*   *phi*   *Nt*   *Finding*   *Wf*  *hc*  *SSH_n*  *Model*; } > temp1.out 2> error1.err


if [ "$(pwd)" == $SCRATCH_DIR ]; then
    echo "Removing files"
    rm $EXEC1
    if [ ! -z "$HELPER1" ] # Check that HELPER isn't empty
    then
	rm $HELPER1
    fi
fi
