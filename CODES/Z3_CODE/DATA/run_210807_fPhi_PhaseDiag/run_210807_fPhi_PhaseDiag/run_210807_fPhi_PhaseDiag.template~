#!/usr/bin/bash
# Template for ".qsub" files that will be run as batch files by slurm

RUN_NAME=run_210807_fPhi_PhaseDiag
PROJECT_NAME=*project*
SCRATCH_DIR=$SCRATCH/$RUN_NAME/b###
LOCAL_DIR=$HOME/Projects/$PROJECT_NAME/build

mkdir -p $SCRATCH_DIR

export JULIA_NUM_THREADS=*JuT*
export OPENBLAS_NUM_THREADS=*OpT*
export OMP_NUM_THREADS=*OmT*

EXEC1=sim_NearlyZero_Z3_EM.py
HELPER1="model_NearlyZero_Z3_EM.py"


cd $LOCAL_DIR/$RUN_NAME
cp $EXEC1 $SCRATCH_DIR/

if [ ! -z "$HELPER1" ] # Check that HELPER isn't empty
then
    cp $HELPER1 $SCRATCH_DIR/
fi
cd $SCRATCH_DIR/

{ /usr/bin/time --verbose    python3 ./$EXEC1  *LLL*   *JJJ*   *fff*  *phi*  *Nt*  *TTT*  ; } > temp1_1.out 2> error1_1.err


if [ "$(pwd)" == $SCRATCH_DIR ]; then
    echo "Removing files"
    rm $EXEC1
    if [ ! -z "$HELPER1" ] # Check that HELPER isn't empty
    then
	rm $HELPER1
    fi
fi
